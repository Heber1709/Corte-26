datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id                  Int               @id @default(autoincrement())
  email               String            @unique
  name                String
  adminInviteHash     String?
  adminInviteExpires  DateTime?
  adminInviteStatus   String?
  phone               String?
  profilePhoto        String?           @db.Text
  birthDate           DateTime?
  role                Role              @default(CLIENT)
  isSuperAdmin        Boolean           @default(false)
  permissions         String[]          @default([])
  points              Int               @default(0)
  strikes             Int               @default(0)
  accountStatus       AccountStatus     @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  passwordCredential PasswordCredential?
  clientAppointments  Appointment[]     @relation("ClientAppointments")
  barberAppointments  Appointment[]     @relation("BarberAppointments")
  facialAnalyses      FacialAnalysis[]
  chatLogs            ChatLog[]
}

model Service {
  id                  Int               @id @default(autoincrement())
  name                String
  description         String?
  price               Decimal           @db.Decimal(10, 2)
  durationMinutes     Int
  requiredPoints      Int?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  appointments        Appointment[]
}

model Appointment {
  id                  Int               @id @default(autoincrement())
  clientId            Int
  barberId            Int
  serviceId           Int
  startTime           DateTime
  endTime             DateTime
  status              AppointmentStatus @default(PENDING)

  chargedPrice        Decimal           @db.Decimal(10, 2)
  earnedPoints        Int               @default(0)
  paidWithPoints      Boolean           @default(false)
  redeemedPoints      Int               @default(0)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  client              User              @relation("ClientAppointments", fields: [clientId], references: [id])
  barber              User              @relation("BarberAppointments", fields: [barberId], references: [id])
  service             Service           @relation(fields: [serviceId], references: [id])

  @@index([barberId, startTime])
  @@index([clientId])
}
model FacialAnalysis {
  id              Int      @id @default(autoincrement())
  userId          Int
  faceShape       String
  recommendations String   @db.Text
  imageUrl        String?  @db.Text
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  userMessage String   @db.Text
  botResponse String   @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordCredential {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash String
  failures Int @default(0)
  lockedUntil DateTime?
}

model EmailRegistration {
  email String @id
  name String
  passwordHash String
  tokenHash String @unique
  expiresAt DateTime
  sentAt DateTime @default(now())
}
